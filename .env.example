# Copy to .env.local for the dashboard (Vite only exposes VITE_* to the browser).
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Edge functions read these from the Supabase project's secrets, not from this file:
#   supabase secrets set SLACK_BOT_TOKEN=xoxb-... SLACK_SIGNING_SECRET=... SLACK_CHANNEL_ID=C... CRON_SECRET=...
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected automatically into edge functions.
